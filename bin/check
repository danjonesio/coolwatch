#!/usr/bin/env bash
# Tests and static gates. `--no-shell` skips the parts that need Omarchy/Qt (CI subset).
set -uo pipefail
export LC_ALL=C.UTF-8   # the « in the SR31 patterns is one character in every locale
root=${COOLWATCH_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}   # override for gate self-tests on a scratch copy
fail() { echo "check: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || fail "missing tool: $1"; }
need node; need jq

node "$root/tests/run.js" || fail "tests"

find "$root" -name .git -prune -o -type l -print -quit | grep -q . && fail "symlink in repo"

[[ -d $root/tests/fixtures ]] || fail "fixtures dir missing"
matches=$(grep -rEl '[0-9]+\|[A-Za-z0-9]{20,}|BEGIN .*PRIVATE KEY|://[^/]*:[^@/]*@' "$root/tests/fixtures"); rc=$?
[[ $rc -eq 1 ]] || fail "secret material in fixtures (grep rc=$rc): $matches"
# SR31 (Phase 4): a "logs" or "configuration_snapshot" key may only hold null or the scrub
# marker, and the keys the read:sensitive token started returning (a bare 40-char webhook
# secret, a Sentinel token, a drain endpoint, a proxy config) may only hold the marker.
# A real log value is doubly-escaped JSON that no line regex can match, so this walks the
# parsed JSON. Hand-written log fixtures keep their entries under "entries" and container
# text under "text"; a recorded fixture carries "logs": "«scrubbed»".
# Non-JSON fixtures (recorded streams, text) keep the literal ban: a raw response stream is
# exactly the shape that would carry a build log.
if grep -rlE --exclude='*.json' '"(logs|configuration_snapshot|manual_webhook_secret_[a-z]+|sentinel_token|sentinel_custom_url|logdrain_[a-z_]+|last_saved_proxy_configuration|last_applied_settings|last_saved_settings|validation_logs)"' "$root/tests/fixtures"; then fail "SR31: a log or sensitive key in a non-JSON fixture"; fi
for fx in "$root"/tests/fixtures/*.json; do
  jq -e '[.. | objects | to_entries[] | select(.key == "logs" or .key == "configuration_snapshot") | select(.value != null and .value != "«scrubbed»")] | length == 0' "$fx" >/dev/null \
    || fail "SR31: $fx holds a logs/configuration_snapshot value that is neither null nor «scrubbed»"
  jq -e '[.. | objects | to_entries[] | select(.key | test("^(manual_webhook_secret_[a-z]+|sentinel_token|sentinel_custom_url|logdrain_[a-z_]+|last_saved_proxy_configuration|last_applied_settings|last_saved_settings|validation_logs)$")) | select(.value != null and .value != "«scrubbed»")] | length == 0' "$fx" >/dev/null \
    || fail "SR31: $fx holds an unscrubbed sensitive key"
done

# SR39: fixtures name no real account (the public-repo rule in docs/development.md; a server IP
# shipped once in 2026-09 and three hostnames survived the rewrite). The key-name gates
# above cannot see a real hostname inside an fqdn, so this is a value gate over every
# fixture, JSON or not: every URL host, bare IPv4 and repository slug must be a
# placeholder, and no commit message may name an owner other than example. Names and
# descriptions are free text and stay a by-hand check.
hosts=$(grep -rhoaE 'https?:(//|\\\\/\\\\/)[^"/ \\]+' "$root/tests/fixtures" | sed -E 's#^https?:(//|\\+/\\+/)##; s#:[0-9]+$##' | sort -u)   # also the https:\/\/ of an escaped-JSON string
bad=$(printf '%s\n' "$hosts" | grep -vE '^(([a-z0-9-]+\.)*example\.(net|com|org)|app\.coolify\.io|localhost|127\.0\.0\.1|10\.[0-9.]+|192\.168\.[0-9.]+|203\.0\.113\.[0-9]+)$' || true)
[[ -z $bad ]] || fail "SR39: a non-placeholder host in a fixture URL: ${bad//$'\n'/ }"
ips=$(grep -rhoaE '\b[0-9]{1,3}(\.[0-9]{1,3}){3}\b' "$root/tests/fixtures" | sort -u)
bad=$(printf '%s\n' "$ips" | grep -vE '^(127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|203\.0\.113\.|0\.0\.0\.0$)' || true)
[[ -z $bad ]] || fail "SR39: a non-placeholder IP in a fixture: ${bad//$'\n'/ }"
for fx in "$root"/tests/fixtures/*.json; do
  jq -e '[.. | objects | to_entries[] | select(.key | test("^(fqdn|domains|docker_compose_domains|git_repository|git_full_url|commit_message|commitMessage)$")) | select(.value | type == "string")
          | select(.key == "git_repository" and (.value | test("^(example/|coollabsio/coolify$)") | not))] | length == 0' "$fx" >/dev/null \
    || fail "SR39: $fx holds a git_repository outside example/"
  jq -e '[.. | objects | to_entries[] | select(.key == "commit_message" or .key == "commitMessage") | select(.value | type == "string")
          | select(.value | test("(?<![A-Za-z0-9_./-])(?!example/)[A-Za-z0-9_-]+/[A-Za-z0-9_./-]+"))] | length == 0' "$fx" >/dev/null \
    || fail "SR39: $fx holds a commit message naming a repository or branch outside example/"
done
n=$(printf '%s\n' "$hosts" | grep -c . || true); [[ $n -ge 3 ]] || fail "SR39 gate matched fewer than three hosts; the fixtures moved"

# Every text item in every QML file is PlainText and pairs pixelSize with family (SR25:
# TextEdit/TextArea count too; log text is the most attacker-influenced string in the product).
for qf in "$root"/*.qml; do
  q=$(basename "$qf")
  t=$(grep -oE '\b(Text|TextEdit|TextArea) \{' "$qf" | wc -l); p=$(grep -oE 'textFormat: Text(Edit)?\.PlainText' "$qf" | wc -l)
  [[ $t -eq $p ]] || fail "$q: $t text blocks, $p PlainText"
  [[ $q != Panel.qml || $t -gt 0 ]] || fail "$q: no Text blocks found"
  s=$(grep -o 'font.pixelSize:' "$qf" | wc -l); f=$(grep -o 'font.family:' "$qf" | wc -l)
  [[ $s -eq $f ]] || fail "$q: $s pixelSize, $f font.family"
done
if grep -nE 'Text\.(RichText|StyledText|MarkdownText|AutoText)' "$root"/*.qml; then fail "SR25: rich text formats are banned"; fi
# SR26: log text never reaches a log line. No console call in Service.qml may name a
# log entry field or the logs key (comments stripped first).
if sed 's#//.*##' "$root/Service.qml" | grep -nE 'console\.(log|warn|error)\(.*(\.output|\.entries|\.lines|\.text\b|logs)'; then fail "SR26: log text in a console line"; fi

if compgen -G "$root/*.qml" >/dev/null && grep -nE '#[0-9a-fA-F]{3,8}\b|font\.family: "|pixelSize: [0-9]|radius: [0-9]' "$root"/*.qml; then
  fail "hardcoded colour/size/font"
fi

# SR9: the browser launcher is only ever called through Util.execArgv with one argument
# (the URL Model.openUrl built from the instance origin), and fqdn never reaches the UI.
# Comments are stripped to end of line first, so a comment can neither satisfy the floor nor hide a call.
launch=$(sed 's#//.*##' "$root"/*.qml | grep 'omarchy-launch-browser' || true)
n=$(printf '%s\n' "$launch" | grep -c 'omarchy-launch-browser' || true)
[[ $n -ge 1 ]] || fail "SR9 gate matched nothing; the launcher was renamed"
bad=$(printf '%s\n' "$launch" | grep -vcE 'Util\.execArgv\(\["omarchy-launch-browser", [A-Za-z_.]+\]\)' || true)
[[ $bad -eq 0 ]] || fail "omarchy-launch-browser must be called as Util.execArgv([\"omarchy-launch-browser\", <one identifier>])"
if grep -n 'fqdn' "$root"/*.qml; then fail "fqdn must never reach the UI"; fi

# SR16 (Phase 3): the notification argv is built in Model.js, so the launcher and the
# notifier keep a checked shape there too, and no QML file ever spawns the notifier.
# "At most once" keeps a rollback of Model.js to Phase 2 green; comments are stripped first,
# so no comment in Model.js may name either program.
mjs=$(sed 's#//.*##' "$root/Model.js")
ln=$(printf '%s\n' "$mjs" | grep -o 'omarchy-launch-browser' | wc -l)     # occurrences, not lines
[[ $ln -le 1 ]] || fail "SR16: omarchy-launch-browser appears $ln times in Model.js; one --exec tail at most"
if [[ $ln -eq 1 ]]; then
  printf '%s\n' "$mjs" | grep 'omarchy-launch-browser' | grep -qE '"--exec", "omarchy-launch-browser", [A-Za-z_.]+\]' \
    || fail "SR16: the launcher in Model.js must be the tail \"--exec\", \"omarchy-launch-browser\", <one identifier>]"
fi
# Phase 4b item 6: the failed toast's tail runs the shell's own CLI with the IPC verb; the
# uuid is one identifier and the verb literal sits between it and the plugin id.
ls=$(printf '%s\n' "$mjs" | grep -o '"omarchy-shell"' | wc -l)
[[ $ls -le 1 ]] || fail "SR16: \"omarchy-shell\" appears $ls times in Model.js; one --exec tail at most"
if [[ $ls -eq 1 ]]; then
  printf '%s\n' "$mjs" | grep '"omarchy-shell"' | grep -qE '"--exec", "omarchy-shell", [A-Za-z_.]+, "log", [A-Za-z_.]+\]' \
    || fail "SR16: the shell tail in Model.js must be \"--exec\", \"omarchy-shell\", <plugin id>, \"log\", <one identifier>]"
fi
nn=$(printf '%s\n' "$mjs" | grep -o 'omarchy-notification-send' | wc -l)
[[ $nn -le 1 ]] || fail "SR16: omarchy-notification-send appears $nn times in Model.js; argv[0] once at most"
if [[ $nn -eq 1 ]]; then
  printf '%s\n' "$mjs" | grep 'omarchy-notification-send' | grep -qF '["omarchy-notification-send", ' \
    || fail "SR16: the notifier in Model.js must open the argv literal [\"omarchy-notification-send\", "
fi
if grep -n 'omarchy-notification-send' "$root"/*.qml; then fail "SR16: the notifier is spawned only from Model.notifyPlan's argv, never from QML"; fi

# SR40 (health before auth, 2026-09-22), part 1: an HTTP 200 whose body does not parse is a
# failure, never a success. _dispatch reports it and _finish's anyOk follows that report,
# so _succeeded cannot clear the error, drop the backoff or lift probe mode on the same pass.
sq=$(sed 's#//.*##' "$root/Service.qml")
nd=$(printf '%s\n' "$sq" | grep -c 'if (ctx._dispatch(' || true)
[[ $nd -eq 1 ]] || fail "SR40: _finish must set anyOk from _dispatch's return once (found $nd)"
na=$(printf '%s\n' "$sq" | grep -c 'anyOk = true' || true)
[[ $na -eq 1 ]] || fail "SR40: anyOk = true must appear exactly once in Service.qml (found $na)"
# SR40 part 2: exactly one descriptor kind is unauthenticated, named by a literal allowlist, and
# the Authorization line is emitted from one conditional site. Widening either is a gate edit.
ajs=$(sed 's#//.*##' "$root/Api.js")
nu=$(printf '%s\n' "$ajs" | grep -cF 'var UNAUTH = { health: true }' || true)
[[ $nu -eq 1 ]] || fail "SR40: Api.js must hold the literal 'var UNAUTH = { health: true }' exactly once (found $nu)"
nh=$(printf '%s\n' "$ajs" | grep -cF 'if (!unauth) s += "header = \"Authorization' || true)
[[ $nh -eq 1 ]] || fail "SR40: the conditional Authorization line must appear exactly once in Api.js (found $nh)"

# Lint the four bin/ scripts with shellcheck. Required in CI (ubuntu-latest ships it); a local
# machine without it skips with a note rather than blocking the dev loop.
if command -v shellcheck >/dev/null; then shellcheck "$root"/bin/* || fail "shellcheck"
elif [[ -n ${CI:-} ]]; then fail "missing tool: shellcheck"
else echo "check: shellcheck not installed; skipped" >&2; fi

[[ ${1:-} == --no-shell ]] && { echo ok; exit 0; }

need omarchy; need rsync; need flock
[[ -x /usr/lib/qt6/bin/qmllint ]] || fail "missing tool: /usr/lib/qt6/bin/qmllint"
stage=$(mktemp -d); trap 'rm -rf "$stage"' EXIT
COOLWATCH_DEST="$stage/plugin" "$root/bin/dev-sync" || fail "dev-sync"
omarchy plugin validate "$stage/plugin" || fail "validate"

# qmllint resolves `import qs.Ui` only from an import root that contains qs/;
# the shim lives in the temp dir, never in the repo or the plugin dir.
mkdir -p "$stage/imports"; ln -s /usr/share/omarchy/shell "$stage/imports/qs"
/usr/lib/qt6/bin/qmllint -I "$stage/imports" --missing-property disable "$root"/*.qml > "$stage/lint.txt" 2>&1 || true
grep -q 'Failed to import qs' "$stage/lint.txt" && fail "qs shim broken; qmllint checked nothing"
# Gate on what the shim buys (import/type resolution) and hard errors; delegate
# scopes produce ~100 [unqualified] warnings in first-party-shaped QML.
# [signal-handler-parameters] fires on every onExited(exitCode, exitStatus): QProcess::ExitStatus
# is not in the qmltypes. First-party services have the same handler shape.
grep -v 'signal-handler-parameters' "$stage/lint.txt" | grep -E 'Failed to import|was not found|inheritance-cycle|unresolved-type|Error:' && fail "qmllint"
echo ok
