{
  "schemaVersion": 1,
  "id": "io.github.danjonesio.omarify",
  "name": "Omarify",
  "version": "0.3.0",
  "author": "Dan Jones",
  "license": "MIT",
  "description": "Coolify in the Omarchy bar: servers, resources, deployments and their status.",
  "kinds": ["service", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omarify",
    "description": "Coolify servers, resources and deployments",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
