#!/usr/bin/env bash
# Render preview.png (2400x1350, the marketplace card) from docs/preview/card.html.
# panel.png is a scale-2 capture of the panel with every real name redrawn as a
# placeholder (AGENTS.md privacy rule); retake it after a panel change and redraw
# the names before committing. Needs chromium, curl, unzip and JetBrainsMono Nerd Font.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd); root=$(cd "$here/../.." && pwd)
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
curl -sSL -o "$tmp/inter.zip" https://github.com/rsms/inter/releases/download/v4.1/Inter-4.1.zip
unzip -q -j "$tmp/inter.zip" extras/ttf/InterDisplay-Bold.ttf -d "$tmp"
sed "s|@INTER@|file://$tmp/InterDisplay-Bold.ttf|" "$here/card.html" > "$tmp/card.html"
cp "$here/panel.png" "$tmp/panel.png"
chromium --headless=new --disable-gpu --hide-scrollbars --user-data-dir="$tmp/profile" \
  --window-size=2400,1350 --force-device-scale-factor=1 \
  --screenshot="$root/preview.png" "file://$tmp/card.html" >/dev/null 2>&1
magick "$root/preview.png" -strip "$root/preview.png"
magick identify "$root/preview.png"
